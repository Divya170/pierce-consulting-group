# NestJS API
PORT=4000
# SQLite file (relative to backend/). Default keeps the DB in ../database/app.sqlite
DATABASE_PATH=../database/app.sqlite
# Allowed browser origin(s), comma separated
CORS_ORIGIN=http://localhost:3000
# Change in production!
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Seeded on first boot only (when no admin exists)
ADMIN_EMAIL=admin@pierceconsulting.com
ADMIN_PASSWORD=PierceAdmin#2026
ADMIN_NAME=Weston Pierce
